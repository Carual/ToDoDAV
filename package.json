{
  "name": "tododav",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Todoist-style task manager on top of CalDAV",
  "type": "module",
  "engines": {
    "bun": ">=1.4",
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently --names backend,web --prefix-colors blue,green --kill-others-on-fail \"npm:dev:backend\" \"npm --prefix frontend run web\"",
    "dev:backend": "bun --watch backend/index.ts",
    "dev:backend:node": "node --watch --env-file-if-exists=.env backend/index.ts",
    "start": "bun backend/index.ts",
    "start:node": "node --env-file-if-exists=.env backend/index.ts",
    "dev:app": "npm --prefix frontend start",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "npm --prefix frontend run export:web",
    "build:apk": "npm --prefix frontend run build:apk",
    "typecheck": "tsc --noEmit && npm run typecheck:app",
    "typecheck:app": "npm --prefix frontend run typecheck"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
