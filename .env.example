# Copy to .env for local development (`npm run dev:backend`). Never commit .env.

# production: /proxy only over HTTPS. Requests must arrive through a TLS reverse proxy that sets
# X-Forwarded-Proto, otherwise they get 403, and CALDAV_URL must be https://.
# The status check at / always answers, even over plain HTTP.
# Anything else (development, or unset): plain HTTP is accepted in both directions.
NODE_ENV=development

# CalDAV server that every /proxy request is sent to.
CALDAV_URL=https://dav.example.com/

# The client must send exactly these credentials (HTTP Basic) or it gets 401.
CALDAV_USERNAME=juan
CALDAV_PASSWORD=change-me

# Default 0.0.0.0: reachable from the network (and the internet, if the port is open).
# Use 127.0.0.1 to allow only programs on this machine, such as a local reverse proxy.
# HOST=0.0.0.0
# PORT=3000

# Public read-only .ics feeds, for calendar apps that cannot log in to CalDAV (Google Calendar's
# "Other calendars > From URL"). Both off by default. They read the CalDAV server with the credentials above.
# /feed/tasks/<token>/juan/tasks/      one task list, its tasks turned into events
# FEED_TASKS_ENABLED=false
# /feed/events/<token>/juan/calendar/  one calendar exactly as the CalDAV server returns it (Radicale)
# FEED_EVENTS_ENABLED=false
# Required when a feed is enabled: at least 32 characters, e.g. `openssl rand -hex 32`.
# Anyone with the URL can read the feed, so keep it secret; change it to revoke old URLs.
# FEED_TOKEN=
